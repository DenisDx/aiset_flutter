{
  "schema": "1",
  "area": "resolver_lookup",
  "id": "lookup_value_is_data_not_template",
  "description": "A value containing a placeholder is returned verbatim.",
  "classes": [
    "single-pass"
  ],
  "input": "",
  "query": {
    "op": "lookup",
    "name": "V",
    "inlineDefault": null
  },
  "layers": {
    "overrides": {
      "V": "${OTHER}"
    },
    "environ": {},
    "dotenv": {}
  },
  "expected": {
    "ok": true,
    "query": {
      "inlineDefault": null,
      "name": "V",
      "op": "lookup"
    },
    "result": {
      "k": "object",
      "v": [
        [
          "value",
          {
            "k": "string",
            "v": "${OTHER}"
          }
        ],
        [
          "source",
          {
            "k": "string",
            "v": "override"
          }
        ]
      ]
    }
  }
}

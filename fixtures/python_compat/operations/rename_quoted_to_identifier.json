  },
  "expected": {
    "ok": true,
    "output": "{\n  new: 1,\n}\n",
    "reparse": {
      "ok": true,
      "paths": [
        "",
        "/new"
      ],
      "storedValue": {
        "k": "object",
        "v": [
          [
            "new",
            {
              "k": "int",
              "v": "1"
            }
          ]
        ]
      }
    }
  }

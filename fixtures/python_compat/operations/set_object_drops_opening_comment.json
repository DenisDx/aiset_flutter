  "id": "set_object_drops_opening_comment",
  "description": "The replaced object's own opening comment is inside the replaced span.",
  "classes": [
    "set",
    "object",
    "comments",
    "opening"
  ],
  "input": "{\n  a: { // opening\n    b: 1,\n  },\n}\n",

    "pointer": "/a",
    "value_text": "{ c: 2 }"
  },
  "expected": {
    "ok": true,
    "output": "{\n  a: {\n    c: 2,\n  },\n}\n",
    "reparse": {
      "ok": true,
      "paths": [

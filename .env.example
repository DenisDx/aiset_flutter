# Placeholder template. Real values belong in a git-ignored file:
# either `.env` or `local_aiset_ai.env` (both excluded by .gitignore).
# Never put a real address, host name or key in this file - see SPEC_.md amendment 36.

# OpenAI-compatible endpoint used by the opt-in AI test suite.
AISET_AI_BASE_URL=
AISET_AI_MODEL=

# Leave empty to send no Authorization header at all. A fabricated token is rejected.
AISET_AI_API_KEY=

# Path to the re-fetched Python reference clone used by the corpus generator.
AISET_PYTHON_BASELINE=
